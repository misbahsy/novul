{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoVul",
  "version": "0.1.0",
  "identifier": "dev.novul.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --bun vite",
    "beforeBuildCommand": "bun run --bun vite build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "externalBin": [
      "binaries/osv-scanner",
      "binaries/gitleaks"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "../design/dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 170,
          "y": 130
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 130
        }
      },
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
